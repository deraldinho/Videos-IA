# Copie para .env. Variáveis do processo têm precedência.
# Cloudinary: Product Environment > API Keys. Não coloque CLOUDINARY_URL em logs.
CLOUDINARY_CLOUD_NAME=  # Cloudinary cloud name (e.g., b8mz9iqf)
CLOUDINARY_API_KEY=  # Cloudinary API key (e.g., 481945185949363)
CLOUDINARY_API_SECRET=  # Cloudinary API secret (e.g., GvWJl6E1rsj0LcSV7C2RtSywpg4)

# Buffer: Settings > API, em uma conta com acesso à organização/canal.
BUFFER_API_KEY=  # Buffer API key (e.g., e5iK_eFes5l5RIS8E5Hbbm4gwGonZG-rTo2Y1oEDZhH)
# Preencha os identificadores se houver mais de uma organização ou canal TikTok.
BUFFER_ORGANIZATION_ID=  # Buffer organization ID
BUFFER_CHANNEL_ID=  # Buffer channel ID

# Opcional: não é a sessão do FCC-Claude. Só use uma cota NVIDIA autorizada.
NVIDIA_API_KEY=  # NVIDIA API key for NIM inference
NVIDIA_MODEL=  # NVIDIA model name (e.g., nvidia/nomotron-3.5-super-vl-120b-a12b)